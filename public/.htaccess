Options -Indexes

# Disable PHP execution by default; only the upload endpoint is explicitly allowed.
<FilesMatch "\\.(php|phtml|php[0-9])$">
  Require all denied
</FilesMatch>
<Files "upload-image.php">
  Require all granted
</Files>

# SPA fallback. Existing files and directories are served normally.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
